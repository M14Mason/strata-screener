# ---------------------------------------------------------------------------
# Market data provider.
#
#   bundle   -> a prebuilt end-of-day dataset on disk. No API calls at request
#               time. This is what a DEPLOYED instance should use.
#   demo     -> deterministic synthetic data. No key, no network, always badged
#               as DEMO DATA in the UI.
#   yahoo    -> real delayed bars with no key, but an undocumented endpoint that
#               rate-limits shared server IPs. Fine locally, unreliable hosted.
#   polygon  -> real end-of-day data. Needs POLYGON_API_KEY.
#   tiingo   -> real adjusted end-of-day data. Needs TIINGO_API_KEY.
#
# Leave this unset and the app uses the prebuilt dataset if one is installed,
# and demo data otherwise.
# ---------------------------------------------------------------------------
# MARKET_DATA_PROVIDER=bundle

# --- API keys (server-side only; never sent to the browser) -----------------
POLYGON_API_KEY=
TIINGO_API_KEY=

# Polygon's free tier allows 5 requests/minute. Set to 0 on a paid plan.
POLYGON_RATE_LIMIT=5

# --- Prebuilt dataset -------------------------------------------------------
# Where the dataset lives on disk.
EOD_BUNDLE_PATH=data/eod-bundle.bin
# Optional: download the dataset at build time instead of committing it.
# The nightly GitHub Action publishes it to the "data-latest" release.
# EOD_BUNDLE_URL=https://github.com/<owner>/<repo>/releases/download/data-latest/eod-bundle.bin

# --- Tuning -----------------------------------------------------------------
# Where fetched bars are cached on disk.
DATA_CACHE_DIR=.cache
# Max simultaneous requests to a network provider.
PROVIDER_CONCURRENCY=12
# Ceiling on symbols per scan. Defaults to 20000 for local datasets, 1200 live.
# SCAN_MAX_SYMBOLS=20000
