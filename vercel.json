{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/screen/route.ts": { "maxDuration": 60 },
    "src/app/api/market/route.ts": { "maxDuration": 60 },
    "src/app/api/stock/[symbol]/route.ts": { "maxDuration": 30 }
  }
}
